#!/usr/bin/env bash

set -eu

state_file="${XDG_RUNTIME_DIR:-/tmp}/waybar-secondary-expanded"
width=$(hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.focused)][0].width // 0')
if [ -e "$state_file" ] && [ "$width" -lt 1800 ]; then
    printf '%s\n' '{"text":"","class":"hidden"}'
    exit 0
fi

exec "$HOME/.local/bin/waybar-mpris-lyrics"
