#!/usr/bin/env bash

set -eu

sum=0
count=0
max_freq=0
for freq_file in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
    [ -r "$freq_file" ] || continue
    freq=$(cat "$freq_file")
    sum=$((sum + freq))
    count=$((count + 1))
    max_file=${freq_file%scaling_cur_freq}cpuinfo_max_freq
    [ -r "$max_file" ] || max_file=${freq_file%scaling_cur_freq}scaling_max_freq
    if [ -r "$max_file" ]; then
        limit=$(cat "$max_file")
        [ "$limit" -gt "$max_freq" ] && max_freq="$limit"
    fi
done

if [ "$count" -gt 0 ]; then
    average=$((sum / count / 1000))
    maximum=$((max_freq / 1000))
    printf '{"text":"/ %s/%sMHz","tooltip":"Average CPU frequency: %s MHz\\nMaximum CPU frequency: %s MHz"}\n' "$average" "$maximum" "$average" "$maximum"
else
    printf '%s\n' '{"text":"/ --","tooltip":"CPU frequency unavailable"}'
fi
