* {
    background: rgba(255, 255, 255, 0.7);
    primary: #33618d;
    primary-fixed: #d0e4ff;
    primary-fixed-dim: #9ecafc;
    on-primary: #ffffff;
    on-primary-fixed: #001d35;
    on-primary-fixed-variant: #164974;
    primary-container: #d0e4ff;
    on-primary-container: #001d35;
    secondary: #526070;
    secondary-fixed: #d6e4f7;
    secondary-fixed-dim: #bac8db;
    on-secondary: #ffffff;
    on-secondary-fixed: #0f1d2a;
    on-secondary-fixed-variant: #3b4857;
    secondary-container: #d6e4f7;
    on-secondary-container: #0f1d2a;
    tertiary: #6a5779;
    tertiary-fixed: #f1daff;
    tertiary-fixed-dim: #d5bee5;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #241532;
    on-tertiary-fixed-variant: #514060;
    tertiary-container: #f1daff;
    on-tertiary-container: #241532;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #f8f9ff;
    on-surface: #191c20;
    on-surface-variant: #42474e;
    outline: #73777f;
    outline-variant: #c2c7cf;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2d3135;
    inverse-on-surface: #eff0f7;
    inverse-primary: #9ecafc;
    surface-dim: #d8dae0;
    surface-bright: #f8f9ff;
    surface-container-lowest: #ffffff;
    surface-container-low: #f2f3f9;
    surface-container: #eceef4;
    surface-container-high: #e6e8ee;
    surface-container-highest: #e0e2e8;
}
