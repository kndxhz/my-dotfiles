* {
    background: rgba(255, 255, 255, 0.7);
    primary: #895120;
    primary-fixed: #ffdcc4;
    primary-fixed-dim: #ffb780;
    on-primary: #ffffff;
    on-primary-fixed: #2f1400;
    on-primary-fixed-variant: #6d3a09;
    primary-container: #ffdcc4;
    on-primary-container: #2f1400;
    secondary: #745944;
    secondary-fixed: #ffdcc4;
    secondary-fixed-dim: #e4bfa7;
    on-secondary: #ffffff;
    on-secondary-fixed: #2a1707;
    on-secondary-fixed-variant: #5b412f;
    secondary-container: #ffdcc4;
    on-secondary-container: #2a1707;
    tertiary: #5d6136;
    tertiary-fixed: #e3e7af;
    tertiary-fixed-dim: #c6ca95;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #1a1d00;
    on-tertiary-fixed-variant: #464a20;
    tertiary-container: #e3e7af;
    on-tertiary-container: #1a1d00;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f5;
    on-surface: #221a14;
    on-surface-variant: #51443b;
    outline: #84746a;
    outline-variant: #d6c3b7;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #382f28;
    inverse-on-surface: #feeee4;
    inverse-primary: #ffb780;
    surface-dim: #e7d7ce;
    surface-bright: #fff8f5;
    surface-container-lowest: #ffffff;
    surface-container-low: #fff1e9;
    surface-container: #fbebe1;
    surface-container-high: #f5e5dc;
    surface-container-highest: #f0dfd6;
}
