* {
    background: rgba(255, 255, 255, 0.7);
    primary: #465d91;
    primary-fixed: #d9e2ff;
    primary-fixed-dim: #b0c6ff;
    on-primary: #ffffff;
    on-primary-fixed: #001944;
    on-primary-fixed-variant: #2e4578;
    primary-container: #d9e2ff;
    on-primary-container: #001944;
    secondary: #575e71;
    secondary-fixed: #dce2f9;
    secondary-fixed-dim: #bfc6dc;
    on-secondary: #ffffff;
    on-secondary-fixed: #141b2c;
    on-secondary-fixed-variant: #404659;
    secondary-container: #dce2f9;
    on-secondary-container: #141b2c;
    tertiary: #725572;
    tertiary-fixed: #fdd7fa;
    tertiary-fixed-dim: #e0bbde;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #2a132c;
    on-tertiary-fixed-variant: #593d5a;
    tertiary-container: #fdd7fa;
    on-tertiary-container: #2a132c;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #faf8ff;
    on-surface: #1a1b20;
    on-surface-variant: #44464f;
    outline: #757780;
    outline-variant: #c5c6d0;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2f3036;
    inverse-on-surface: #f1f0f7;
    inverse-primary: #b0c6ff;
    surface-dim: #dad9e0;
    surface-bright: #faf8ff;
    surface-container-lowest: #ffffff;
    surface-container-low: #f4f3fa;
    surface-container: #eeedf4;
    surface-container-high: #e8e7ef;
    surface-container-highest: #e2e2e9;
}
