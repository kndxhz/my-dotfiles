* {
    background: rgba(255, 255, 255, 0.7);
    primary: #4c5c92;
    primary-fixed: #dce1ff;
    primary-fixed-dim: #b5c4ff;
    on-primary: #ffffff;
    on-primary-fixed: #02174b;
    on-primary-fixed-variant: #344479;
    primary-container: #dce1ff;
    on-primary-container: #02174b;
    secondary: #595e72;
    secondary-fixed: #dee1f9;
    secondary-fixed-dim: #c1c5dd;
    on-secondary: #ffffff;
    on-secondary-fixed: #161b2c;
    on-secondary-fixed-variant: #414659;
    secondary-container: #dee1f9;
    on-secondary-container: #161b2c;
    tertiary: #745470;
    tertiary-fixed: #ffd7f6;
    tertiary-fixed-dim: #e3badb;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #2c122a;
    on-tertiary-fixed-variant: #5b3d57;
    tertiary-container: #ffd7f6;
    on-tertiary-container: #2c122a;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #faf8ff;
    on-surface: #1a1b21;
    on-surface-variant: #45464f;
    outline: #767680;
    outline-variant: #c6c6d0;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2f3036;
    inverse-on-surface: #f1f0f7;
    inverse-primary: #b5c4ff;
    surface-dim: #dad9e0;
    surface-bright: #faf8ff;
    surface-container-lowest: #ffffff;
    surface-container-low: #f4f3fa;
    surface-container: #eeedf4;
    surface-container-high: #e9e7ef;
    surface-container-highest: #e3e1e9;
}
