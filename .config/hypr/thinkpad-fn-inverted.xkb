// ThinkPad T14 Gen 4: FnLock LED off = F1-F12, LED on = special keys.
// Fn temporarily selects the opposite row, as handled by the firmware.
// Apply only to the built-in keyboard and its ACPI companion devices.
xkb_keymap {
    xkb_keycodes { include "evdev+aliases(qwerty)" };
    xkb_types { include "complete" };
    xkb_compat { include "complete" };
    xkb_symbols {
        include "pc+us+inet(evdev)"
        name[Group1] = "ThinkPad Fn inverted (US, VT enabled)";

        replace key <FK01> { type[Group1] = "ONE_LEVEL", [ XF86AudioMute ] };
        replace key <FK02> { type[Group1] = "ONE_LEVEL", [ XF86AudioLowerVolume ] };
        replace key <FK03> { type[Group1] = "ONE_LEVEL", [ XF86AudioRaiseVolume ] };
        replace key <FK04> { type[Group1] = "ONE_LEVEL", [ XF86AudioMicMute ] };
        replace key <FK05> { type[Group1] = "ONE_LEVEL", [ XF86MonBrightnessDown ] };
        replace key <FK06> { type[Group1] = "ONE_LEVEL", [ XF86MonBrightnessUp ] };
        replace key <FK07> { type[Group1] = "ONE_LEVEL", [ XF86Display ] };
        replace key <FK08> { type[Group1] = "ONE_LEVEL", [ XF86WLAN ] };
        replace key <FK09> { type[Group1] = "ONE_LEVEL", [ XF86NotificationCenter ] };
        replace key <FK10> { type[Group1] = "ONE_LEVEL", [ XF86PickupPhone ] };
        replace key <FK11> { type[Group1] = "ONE_LEVEL", [ XF86HangupPhone ] };
        replace key <FK12> { type[Group1] = "ONE_LEVEL", [ XF86Favorites ] };

        // Preserve the standard Ctrl+Alt virtual-terminal switching level.
        replace key <MUTE> { type[Group1] = "CTRL+ALT", [ F1, F1, F1, F1, XF86_Switch_VT_1 ] };
        replace key <VOL-> { type[Group1] = "CTRL+ALT", [ F2, F2, F2, F2, XF86_Switch_VT_2 ] };
        replace key <VOL+> { type[Group1] = "CTRL+ALT", [ F3, F3, F3, F3, XF86_Switch_VT_3 ] };
        replace key <FK20> { type[Group1] = "CTRL+ALT", [ F4, F4, F4, F4, XF86_Switch_VT_4 ] };
        replace key <I256> { type[Group1] = "CTRL+ALT", [ F4, F4, F4, F4, XF86_Switch_VT_4 ] };
        replace key <I232> { type[Group1] = "CTRL+ALT", [ F5, F5, F5, F5, XF86_Switch_VT_5 ] };
        replace key <I233> { type[Group1] = "CTRL+ALT", [ F6, F6, F6, F6, XF86_Switch_VT_6 ] };
        replace key <I235> { type[Group1] = "CTRL+ALT", [ F7, F7, F7, F7, XF86_Switch_VT_7 ] };
        replace key <I246> { type[Group1] = "CTRL+ALT", [ F8, F8, F8, F8, XF86_Switch_VT_8 ] };
        replace key <I255> { type[Group1] = "CTRL+ALT", [ F8, F8, F8, F8, XF86_Switch_VT_8 ] };
        replace key <I452> { type[Group1] = "CTRL+ALT", [ F9, F9, F9, F9, XF86_Switch_VT_9 ] };
        replace key <I453> { type[Group1] = "CTRL+ALT", [ F10, F10, F10, F10, XF86_Switch_VT_10 ] };
        replace key <I454> { type[Group1] = "CTRL+ALT", [ F11, F11, F11, F11, XF86_Switch_VT_11 ] };
        replace key <I164> { type[Group1] = "CTRL+ALT", [ F12, F12, F12, F12, XF86_Switch_VT_12 ] };
    };
};
