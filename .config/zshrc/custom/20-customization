# -----------------------------------------------------
# CUSTOMIZATION (user override)
# -----------------------------------------------------
POSH=agnoster

# -----------------------------------------------------
# oh-myzsh themes: https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
# -----------------------------------------------------
ZSH_THEME="powerlevel10k/powerlevel10k"

# -----------------------------------------------------
# oh-my-zsh plugins
# -----------------------------------------------------
plugins=(
    git
    sudo
    web-search
    archlinux
    zsh-autosuggestions
    extract
    zoxide
    copyfile
    copybuffer
    dirhistory
    catimg
    bgnotify
    colored-man-pages
    history
    command-not-found
    you-should-use
    zsh-syntax-highlighting
)

# Notify only after more than five minutes (integer seconds, >= threshold).
bgnotify_threshold=301

# Set-up oh-my-zsh
source $ZSH/oh-my-zsh.sh

# -----------------------------------------------------
# Set-up FZF key bindings (CTRL R for fuzzy history finder)
# -----------------------------------------------------
source <(fzf --zsh)

# zsh history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory

# -----------------------------------------------------
# Prompt
# -----------------------------------------------------
# Previous prompt: Oh My Posh Zen
# eval "$(oh-my-posh init zsh --config $HOME/.config/ohmyposh/zen.toml)"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
