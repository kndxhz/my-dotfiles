{
    // General Settings
    "layer": "top",
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "fixed-center": false,
    // Load Modules
    "include": [
        "~/.config/ml4w/settings/waybar-quicklinks.json",
        "~/.config/waybar/modules.json"
    ],
    // Modules Left
    "modules-left": [
        "custom/appmenu",
        "group/workspace-buttons",
        "custom/lyrics",
        //"wlr/taskbar",
        //"group/quicklinks",
        //"custom/nowplaying",        
        "custom/empty"
    ],
    // Display empty slots without creating persistent compositor workspaces.
    "group/workspace-buttons": {
        "orientation": "horizontal",
        "modules": [
            "custom/workspace1",
            "custom/workspace2",
            "custom/workspace3",
            "custom/workspace4",
            "custom/workspace5"
        ]
    },
    "custom/workspace1": {
        "exec": "python3 ~/.config/waybar/themes/new_waybar/workspace-status.py 1",
        "return-type": "json",
        "restart-interval": 1,
        "exec-on-event": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = \"1\"})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e+1\"})'"
    },
    "custom/workspace2": {
        "exec": "python3 ~/.config/waybar/themes/new_waybar/workspace-status.py 2",
        "return-type": "json",
        "restart-interval": 1,
        "exec-on-event": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = \"2\"})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e+1\"})'"
    },
    "custom/workspace3": {
        "exec": "python3 ~/.config/waybar/themes/new_waybar/workspace-status.py 3",
        "return-type": "json",
        "restart-interval": 1,
        "exec-on-event": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = \"3\"})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e+1\"})'"
    },
    "custom/workspace4": {
        "exec": "python3 ~/.config/waybar/themes/new_waybar/workspace-status.py 4",
        "return-type": "json",
        "restart-interval": 1,
        "exec-on-event": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = \"4\"})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e+1\"})'"
    },
    "custom/workspace5": {
        "exec": "python3 ~/.config/waybar/themes/new_waybar/workspace-status.py 5",
        "return-type": "json",
        "restart-interval": 1,
        "exec-on-event": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = \"5\"})'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e-1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace = \"e+1\"})'"
    },
    // Modules Center
    "modules-center": [
        "hyprland/window",
        "custom/empty"
    ],
    // Modules Right    
    "modules-right": [
        "tray",
        "group/secondary",
        "custom/notification",
        "custom/exit",
        "battery",
        "pulseaudio",
        "clock"
    ]
}
